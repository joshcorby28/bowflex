    "custom_liquid_CzCEmc": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "{% comment %}\n  BowFlex Adjustable Dumbbells FAQ\n  Designed for Shopify Custom Liquid\n{% endcomment %}\n\n<section class=\"bowflex-faq-section\">\n  <div class=\"bowflex-faq-container\">\n\n    <div class=\"bowflex-faq-header\">\n      <span class=\"bowflex-faq-eyebrow\">ADJUSTABLE DUMBBELLS</span>\n      <h2>Frequently Asked Questions</h2>\n      <p>\n        Everything you need to know about choosing and using BowFlex SelectTech adjustable dumbbells for home strength training.\n      </p>\n    </div>\n\n    <div class=\"bowflex-faq-group\">\n\n      <h3 class=\"bowflex-faq-category\">Product &amp; Weight Selection</h3>\n\n      <details class=\"bowflex-faq-item\">\n        <summary>\n          <span>Why choose BowFlex SelectTech adjustable dumbbells for home strength training?</span>\n          <span class=\"bowflex-faq-icon\" aria-hidden=\"true\"></span>\n        </summary>\n        <div class=\"bowflex-faq-answer\">\n          <p>\n            As the world’s best-selling adjustable dumbbell brand, BowFlex offers SelectTech adjustable dumbbells that are one of the best choices for home strength training.\n          </p>\n          <p>\n            A single compact system provides multiple weight settings, helping users save space compared with a full fixed dumbbell rack. The quick adjustment design also makes it easy to switch weights between exercises, supporting a wide range of strength training needs from beginners to more advanced users.\n          </p>\n          <p>\n            For users who want flexible weight training at home without storing many pairs of fixed dumbbells, BowFlex SelectTech is a practical, trusted and space-saving choice.\n          </p>\n          <p>\n            Current options include <strong>BowFlex 52</strong>, <strong>BowFlex 552</strong> and <strong>BowFlex 1090</strong>, allowing users to choose the right model based on training intensity, target muscle groups and long-term strength goals.\n          </p>\n        </div>\n      </details>\n\n      <details class=\"bowflex-faq-item\">\n        <summary>\n          <span>What weight range do BowFlex adjustable dumbbells offer?</span>\n          <span class=\"bowflex-faq-icon\" aria-hidden=\"true\"></span>\n        </summary>\n        <div class=\"bowflex-faq-answer\">\n          <p>\n            BowFlex adjustable dumbbells offer different weight ranges depending on the model.\n          </p>\n\n          <p>\n            <strong>BowFlex 52 and BowFlex 552</strong> adjust from\n            <strong>5 to 52.5 lbs per dumbbell</strong>, approximately\n            <strong>2.3 to 23.9 kg</strong>. They are well suited for general home workouts, beginners, upper-body exercises and moderate full-body training.\n          </p>\n\n          <p>\n            <strong>BowFlex 1090</strong> adjusts from\n            <strong>10 to 90 lbs per dumbbell</strong>, approximately\n            <strong>4.5 to 40.8 kg</strong>. It offers a heavier overall weight range, making it better suited for heavier compound exercises such as chest presses, rows, squats, lunges and deadlifts.\n          </p>\n        </div>\n      </details>\n\n      <details class=\"bowflex-faq-item\">\n        <summary>\n          <span>Should I choose BowFlex 52, BowFlex 552, or BowFlex 1090?</span>\n          <span class=\"bowflex-faq-icon\" aria-hidden=\"true\"></span>\n        </summary>\n        <div class=\"bowflex-faq-answer\">\n          <p>\n            Choose <strong>BowFlex 52</strong> or <strong>BowFlex 552</strong> if you want a space-saving adjustable dumbbell for general home strength training, beginners, upper-body exercises and moderate full-body workouts. Both adjust from <strong>5 to 52.5 lbs per dumbbell</strong>.\n          </p>\n\n          <p>\n            Choose <strong>BowFlex 52</strong> if you prefer a more traditional dumbbell shape, and choose <strong>BowFlex 552</strong> if you prefer the classic curved SelectTech shape.\n          </p>\n\n          <p>\n            Choose <strong>BowFlex 1090</strong> if you need a heavier range, from <strong>10 to 90 lbs per dumbbell</strong>, for heavier presses, rows, squats, lunges, deadlifts and long-term strength progression.\n          </p>\n        </div>\n      </details>\n\n    </div>\n\n    <div class=\"bowflex-faq-group\">\n\n      <h3 class=\"bowflex-faq-category\">Home Use &amp; Training</h3>\n\n      <details class=\"bowflex-faq-item\">\n        <summary>\n          <span>Can BowFlex SelectTech adjustable dumbbells replace a full dumbbell set at home?</span>\n          <span class=\"bowflex-faq-icon\" aria-hidden=\"true\"></span>\n        </summary>\n        <div class=\"bowflex-faq-answer\">\n          <p>\n            Yes, for most home strength training needs. Depending on the model, BowFlex SelectTech adjustable dumbbells can replace multiple pairs of fixed dumbbells by letting you select different weights from one compact system.\n          </p>\n          <p>\n            This makes them especially useful for users with limited space, apartment gyms or anyone who wants a cleaner home workout setup.\n          </p>\n        </div>\n      </details>\n\n      <details class=\"bowflex-faq-item\">\n        <summary>\n          <span>How do BowFlex SelectTech adjustable dumbbells work?</span>\n          <span class=\"bowflex-faq-icon\" aria-hidden=\"true\"></span>\n        </summary>\n        <div class=\"bowflex-faq-answer\">\n          <p>\n            Place the BowFlex dumbbell fully in its base, select the desired weight using the adjustment dial or selector mechanism, and lift the handle only after the weight is fully selected.\n          </p>\n          <p>\n            The selected plates stay attached to the handle while the unselected plates remain in the base.\n          </p>\n        </div>\n      </details>\n\n    </div>\n\n  </div>\n</section>\n\n<style>\n  .bowflex-faq-section {\n    width: 100%;\n    padding: 60px 20px;\n    background: #ffffff;\n    color: #161616;\n  }\n\n  .bowflex-faq-container {\n    width: 100%;\n    max-width: 1100px;\n    margin: 0 auto;\n  }\n\n  .bowflex-faq-header {\n    max-width: 760px;\n    margin-bottom: 45px;\n  }\n\n  .bowflex-faq-eyebrow {\n    display: block;\n    margin-bottom: 10px;\n    font-size: 12px;\n    font-weight: 700;\n    letter-spacing: 1.8px;\n    text-transform: uppercase;\n  }\n\n  .bowflex-faq-header h2 {\n    margin: 0 0 14px;\n    padding: 0;\n    font-size: clamp(30px, 4vw, 44px);\n    line-height: 1.1;\n    font-weight: 700;\n    letter-spacing: -0.8px;\n  }\n\n  .bowflex-faq-header p {\n    margin: 0;\n    max-width: 700px;\n    font-size: 16px;\n    line-height: 1.7;\n    color: #555555;\n  }\n\n  .bowflex-faq-group {\n    margin-bottom: 42px;\n  }\n\n  .bowflex-faq-group:last-child {\n    margin-bottom: 0;\n  }\n\n  .bowflex-faq-category {\n    margin: 0 0 14px;\n    padding: 0;\n    font-size: 18px;\n    line-height: 1.3;\n    font-weight: 700;\n  }\n\n  .bowflex-faq-item {\n    border-top: 1px solid #dedede;\n    margin: 0;\n  }\n\n  .bowflex-faq-item:last-child {\n    border-bottom: 1px solid #dedede;\n  }\n\n  .bowflex-faq-item summary {\n    position: relative;\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 25px;\n    padding: 23px 5px;\n    list-style: none;\n    cursor: pointer;\n    font-size: 17px;\n    line-height: 1.45;\n    font-weight: 600;\n    transition: opacity 0.2s ease;\n  }\n\n  .bowflex-faq-item summary::-webkit-details-marker {\n    display: none;\n  }\n\n  .bowflex-faq-item summary::marker {\n    display: none;\n    content: \"\";\n  }\n\n  .bowflex-faq-item summary:hover {\n    opacity: 0.7;\n  }\n\n  .bowflex-faq-icon {\n    position: relative;\n    display: block;\n    flex: 0 0 18px;\n    width: 18px;\n    height: 18px;\n  }\n\n  .bowflex-faq-icon::before,\n  .bowflex-faq-icon::after {\n    content: \"\";\n    position: absolute;\n    top: 50%;\n    left: 50%;\n    width: 16px;\n    height: 2px;\n    background: currentColor;\n    transform: translate(-50%, -50%);\n    transition: transform 0.25s ease;\n  }\n\n  .bowflex-faq-icon::after {\n    transform: translate(-50%, -50%) rotate(90deg);\n  }\n\n  .bowflex-faq-item[open] .bowflex-faq-icon::after {\n    transform: translate(-50%, -50%) rotate(0deg);\n  }\n\n  .bowflex-faq-answer {\n    max-width: 900px;\n    padding: 0 45px 25px 5px;\n    color: #555555;\n    font-size: 15.5px;\n    line-height: 1.75;\n  }\n\n  .bowflex-faq-answer p {\n    margin: 0 0 14px;\n  }\n\n  .bowflex-faq-answer p:last-child {\n    margin-bottom: 0;\n  }\n\n  .bowflex-faq-answer strong {\n    color: #222222;\n    font-weight: 600;\n  }\n\n  @media screen and (max-width: 749px) {\n    .bowflex-faq-section {\n      padding: 40px 16px;\n    }\n\n    .bowflex-faq-header {\n      margin-bottom: 35px;\n    }\n\n    .bowflex-faq-header h2 {\n      font-size: 30px;\n    }\n\n    .bowflex-faq-header p {\n      font-size: 15px;\n    }\n\n    .bowflex-faq-category {\n      font-size: 17px;\n    }\n\n    .bowflex-faq-item summary {\n      padding: 19px 2px;\n      font-size: 15.5px;\n      gap: 16px;\n    }\n\n    .bowflex-faq-answer {\n      padding: 0 28px 22px 2px;\n      font-size: 14.5px;\n    }\n  }\n</style>\n\n<script type=\"application/ld+json\">\n{\n  \"@context\": \"https://schema.org\",\n  \"@type\": \"FAQPage\",\n  \"mainEntity\": [\n    {\n      \"@type\": \"Question\",\n      \"name\": \"Why choose BowFlex SelectTech adjustable dumbbells for home strength training?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"As the world’s best-selling adjustable dumbbell brand, BowFlex offers SelectTech adjustable dumbbells that are one of the best choices for home strength training. A single compact system provides multiple weight settings, helping users save space compared with a full fixed dumbbell rack. The quick adjustment design also makes it easy to switch weights between exercises, supporting a wide range of strength training needs from beginners to more advanced users. Current options include BowFlex 52, BowFlex 552, and BowFlex 1090.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"What weight range do BowFlex adjustable dumbbells offer?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"BowFlex 52 and BowFlex 552 adjust from 5 to 52.5 lbs per dumbbell, approximately 2.3 to 23.9 kg. BowFlex 1090 adjusts from 10 to 90 lbs per dumbbell, approximately 4.5 to 40.8 kg.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"Should I choose BowFlex 52, BowFlex 552, or BowFlex 1090?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"Choose BowFlex 52 or BowFlex 552 for general home strength training, beginners, upper-body exercises and moderate full-body workouts. Choose BowFlex 52 for a more traditional dumbbell shape or BowFlex 552 for the classic curved SelectTech shape. Choose BowFlex 1090 for a heavier 10 to 90 lb range suited to heavier presses, rows, squats, lunges, deadlifts and long-term strength progression.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"Can BowFlex SelectTech adjustable dumbbells replace a full dumbbell set at home?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"Yes, for most home strength training needs. BowFlex SelectTech adjustable dumbbells can replace multiple pairs of fixed dumbbells by allowing different weights to be selected from one compact system, making them useful for limited spaces, apartment gyms and cleaner home workout setups.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"How do BowFlex SelectTech adjustable dumbbells work?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"Place the BowFlex dumbbell fully in its base, select the desired weight using the adjustment dial or selector mechanism, and lift the handle only after the weight is fully selected. The selected plates stay attached to the handle while the unselected plates remain in the base.\"\n      }\n    }\n  ]\n}\n</script>",
